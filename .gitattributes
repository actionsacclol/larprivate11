# Line endings are load-bearing here, in both directions.
#
#   .sh  must be LF   — CRLF gives "bad interpreter: /usr/bin/env bash^M"
#                       on the macOS and Linux runners
#   .cmd must be CRLF — cmd.exe mis-parses LF-only batch files, dropping
#                       characters progressively (this actually happened)

* text=auto eol=lf

*.sh   text eol=lf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.nsh  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.icns binary
