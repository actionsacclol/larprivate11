node_modules/
release/
dist/

# ---- Reference material, not part of the build ----
# Screenshots of real apps used only as design reference while building the
# recreations. They're large, they're other people's artwork, and nothing in
# the build reads them — the *generated* icons below are committed instead,
# so CI can package without them.
/appicons/
/appstore screenshots/
/apple healthj/
/cashappss/
/insta/
/kalshi/
/venmo/
/whop/
/IMG_*.png
/x.jpg

# ---- Local ----
*.log
.DS_Store
Thumbs.db

# NOTE: assets/icons, assets/manifests, assets/coins, assets/appstore,
# resources/krypt.* and build/icon.png are deliberately committed. They are
# generated by `npm run icons` / `npm run images`, but those scripts read
# source images that live outside the repo, so the CI runners cannot
# regenerate them. Committing the output keeps packaging reproducible.
